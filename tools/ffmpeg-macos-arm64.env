# FFmpeg for the macOS (Apple Silicon / arm64) build, downloaded by
# scripts/fetch-ffmpeg-mac.sh. Pinned to one release so every build uses the
# same binaries. To upgrade: change both lines, delete
# tools/ffmpeg-macos-arm64.lock, then build again (tests must pass).
# Source: https://ffmpeg.martin-riedl.de/ (signed macOS builds with libx264 and LAME)
FFMPEG_VERSION="9.0.2"
FFMPEG_BASE="https://ffmpeg.martin-riedl.de/download/macos/arm64/1789931890_9.0.2"
